" Basic behavior
set autoread

" Remember cursor position (except in commit messages)
augroup restore_cursor
    autocmd!
    autocmd BufReadPost *
        \ if line("'\"") >= 1 && line("'\"") <= line("$") && &ft !~# 'commit'
        \ |   exe "normal! g`\""
        \ | endif
augroup END

" Syntax and file types
syntax on
filetype plugin indent on

" Indentation
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent

" Editing
set backspace=indent,eol,start

" Search improvements
set hlsearch
set incsearch
set ignorecase
set smartcase

" Better file handling
set hidden
set confirm

" Display
set number
set showcmd
set ruler
set wildmenu
set colorcolumn=120
highlight ColorColumn ctermbg=234 guibg=#1c1c1c

" Performance
set lazyredraw

" Disable bells
set belloff=all
