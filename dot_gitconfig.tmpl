[user]
    name = Ben Prisby
{{- if eq .chezmoi.hostname .puzzle.hostname }}
    email = {{ .puzzle.email }}
{{- else }}
    email = {{ .personal.email }}
{{- end }}

[init]
    defaultBranch = main

[commit]
    verbose = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[fetch]
    prune = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true
    updateRefs = true

[diff]
    algorithm = histogram
    colorMoved = plain

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true
