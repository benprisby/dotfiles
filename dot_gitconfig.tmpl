[user]
    name = Ben Prisby
{{- if eq .chezmoi.hostname .puzzle.hostname }}
    email = {{ .puzzle.email }}
{{- else }}
    email = {{ .personal.email }}
{{- end }}

[core]
    editor = vim

[init]
    defaultBranch = main

[pull]
    rebase = true

[rebase]
    autoStash = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true
