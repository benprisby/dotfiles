# Keep PATH entries unique (zsh ties the $path array to $PATH).
typeset -U path

# Homebrew setup
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
export HOMEBREW_AUTO_UPDATE_SECS=604800

# Cargo setup
[[ -f ${HOME}/.cargo/env ]] && source "${HOME}/.cargo/env"

# PATH configuration
path=("${HOME}/.local/bin" $path)
path+=("${HOME}/.docker/bin")  # Docker Desktop user-level CLI tools

# Default editor
export EDITOR=nvim

# Locale setup
export LANG=en_US.UTF-8
